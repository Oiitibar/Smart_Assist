# ==================================================
# Logs
# ==================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ==================================================
# Dependencies
# ==================================================
node_modules/
**/node_modules/


# ==================================================
# Build output
# ==================================================
dist/
**/dist/
dist-ssr/
**/dist-ssr/
coverage/


# ==================================================
# Environment files and secrets
# ==================================================
.env
.env.*
**/.env
**/.env.*

# Keep safe example environment files
!.env.example
!**/.env.example


# ==================================================
# Smart Assist uploaded files
# ==================================================

# Ignore files directly inside uploads
backend/uploads/*

# Keep the folder structure
!backend/uploads/.gitkeep
!backend/uploads/avatars/
!backend/uploads/materials/

# Ignore uploaded avatar images
backend/uploads/avatars/*
!backend/uploads/avatars/.gitkeep

# Ignore uploaded PDF, DOCX and PPTX materials
backend/uploads/materials/*
!backend/uploads/materials/.gitkeep


# ==================================================
# Generated document preview cache
# ==================================================
backend/previews/*
!backend/previews/.gitkeep


# ==================================================
# Local files
# ==================================================
*.local
.vercel/
.cache/
tmp/
temp/


# ==================================================
# Editor directories and files
# ==================================================
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?